{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/lannerk/agent-catalog/main/mcp/shard.schema.json",
  "title": "agent-catalog MCP mirror shard (schema 1)",
  "description": "mcp/servers/<digit>.json: the latest, not deleted version of each server whose sha256(name) starts with <digit>, sorted by name. `server` holds the registry's fields clients use, as the registry wrote them (each was checked against the official server.schema.json it named).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "shard", "servers"],
  "properties": {
    "schema": { "const": 1 },
    "shard": { "type": "string", "pattern": "^[0-9a-f]$" },
    "servers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["server", "status", "updated_at"],
        "properties": {
          "server": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "description", "version"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "title": { "type": "string" },
              "description": { "type": "string", "minLength": 1 },
              "version": { "type": "string", "minLength": 1 },
              "websiteUrl": { "type": "string" },
              "repository": { "type": "object" },
              "icons": { "type": "array" },
              "packages": { "type": "array", "items": { "type": "object" } },
              "remotes": { "type": "array", "items": { "type": "object" } }
            }
          },
          "status": { "enum": ["active", "deprecated"] },
          "updated_at": { "type": ["string", "null"] }
        }
      }
    }
  }
}
